# --- Gemini ---
# المفاتيح بالترتيب؛ عند نفاد الحصة أو 429/رفض المفتاح ينتقل العميل للتالي.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# توافق اختياري مع الإعداد القديم: يُستخدم فقط إن كان GEMINI_API_KEY_1 فارغًا.
GEMINI_API_KEY=
# نموذج Gemini الاحتياطي عند تعذر Groq في التحليل والفحص
GEMINI_MODEL=gemini-3.5-flash-lite
# نموذج كتابة المقال والعناوين وSEO والمنشور/التعليق مع بدائل عند انتهاء الحصة
GEMINI_CONTENT_MODEL=gemini-3.8-flash
GEMINI_CONTENT_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash
# يُستخدم فقط لصورة المقال إذا IMAGE_PROVIDER=gemini؛ صورة Facebook تستخدم صور المقال الأصلية.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# --- Blogger / Google OAuth ---
BLOGGER_BLOG_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Twilio WhatsApp ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
YOUR_PERSONAL_NUMBER=
# اختياري: Content SID لقالب معتمد (للإرسال خارج نافذة 24 ساعة)
WHATSAPP_CONTENT_SID=

# --- Images ---
# اختياري لصورة المقال فقط عند IMAGE_PROVIDER=gemini؛ إذا تُرك فارغًا تُجرَّب مفاتيح Gemini الثلاثة.
IMAGE_API_KEY=

# مزود صورة المقال فقط: cloudflare | gemini  (نماذج صور Gemini قد تحتاج فوترة)
IMAGE_PROVIDER=cloudflare

# أسلوب صورة المقال فقط: faithful (حتى 3 مراجع أصلية) | creative (ما زالت المراجع تُستخدم عند توفرها)
IMAGE_MODE=faithful
# وصف الأسلوب التحريري النظيف والحاد (بالإنجليزية). اتركه فارغًا لاستخدام الافتراضي
CINEMATIC_STYLE=

# Keep visible faces from the source reference (legacy env knob; normalized to reference).
PEOPLE_IMAGE_STYLE=reference

# صورة Facebook إلزامية ومربعة، تُركّب من بكسلات صور المقال الأصلية فقط.
# لا تُرسل إلى Cloudflare أو Gemini للتوليد؛ عند غياب صور مصدر صالحة تفشل مرحلة الصورة بوضوح.

# اختياري: رابط عام لمجلد الصور
# مثال: https://raw.githubusercontent.com/OWNER/REPO/main/data/images
IMAGE_PUBLIC_BASE_URL=

# --- Cloudflare Workers AI (يُستخدم عندما IMAGE_PROVIDER=cloudflare) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-dev
CLOUDFLARE_IMAGE_STEPS=25
# الدقة الأساسية للضلع الأطول: 1024..1920؛ القيمة الافتراضية 1536 للجودة الأعلى.
IMAGE_LONG_SIDE=1536
# أول طلب قد يكون بطيئًا (بدء بارد)، فلا تخفض هذه القيمة عن 300
CLOUDFLARE_TIMEOUT=300

# --- Targets ---
TARGET_DAILY_STORIES=6
MAX_STORIES_PER_RUN=3
MAX_SOURCE_AGE_HOURS=48
MIN_VIRAL_SCORE=60
DAY_TIMEZONE=Africa/Casablanca

# --- Network ---
REQUEST_TIMEOUT=60
IMAGE_REQUEST_TIMEOUT=180
MAX_RETRIES=3
PER_HOST_DELAY_SECONDS=2.0
USER_AGENT=ViralStoriesFactoryBot/1.0

# --- Files ---
HISTORY_FILE=data/history.json
SOURCES_OVERRIDE_FILE=

# --- Behaviour ---
DRY_RUN=true
DRY_RUN_GENERATE_IMAGES=false
GIT_PUSH_ENABLED=false

# يتجاوز الحد اليومي (للتشغيل اليدوي فقط)
MANUAL_OVERRIDE=false

IMAGE_VLM_CHECK=true

# إذا true لا يُنشر المقال بدون صورة صالحة
# عند فشل الصورة تصبح القصة image_failed
IMAGE_REQUIRED=true

# --- Facebook image ---
# سياسة Facebook ثابتة في الكود: صور المصدر الأصلية فقط، بلا توليد AI.
# auto | inset_circle_right | inset_circle_left | inset_square_right | inset_square_left
# diptych_split | diptych_stack | triptych | triptych_bottom | quad_grid | single_hero
FACEBOOK_LAYOUT=auto

# --- Groq (primary for triage, fact-checking, visual/photo analysis; Gemini fallback) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
