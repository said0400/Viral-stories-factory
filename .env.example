# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# --- Blogger / Google OAuth ---
BLOGGER_BLOG_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Twilio WhatsApp ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
YOUR_PERSONAL_NUMBER=
# اختياري: Content SID لقالب معتمد للإرسال خارج نافذة 24 ساعة
WHATSAPP_CONTENT_SID=

# --- Images ---
# إذا تُرك فارغًا يُستخدم GEMINI_API_KEY
IMAGE_API_KEY=

# سياسة صور الأشخاص:
# reference | illustration | faceless
#
# reference:
#   يستخدم الصورة المرجعية عند السماح بذلك، مع تجنب إعادة إنشاء
#   هوية/وجه شخص حقيقي بشكل واقعي.
#
# illustration:
#   يحول الأشخاص إلى أسلوب توضيحي/تحريري آمن.
#
# faceless:
#   يتجنب إظهار ملامح الوجه.
PEOPLE_IMAGE_STYLE=reference

# أنشئ صورة منفصلة لفيسبوك بالإضافة إلى صورة المقال
# يمكن أن تكون 16:9 أو 1.91:1 حسب مولد الصور.
FACEBOOK_SEPARATE_IMAGE=true

# اختياري: رابط عام لمجلد الصور.
# إذا كان فارغًا، لن يتم إنشاء روابط عامة للصور تلقائيًا.
IMAGE_PUBLIC_BASE_URL=

# --- Targets ---
TARGET_DAILY_STORIES=6
MAX_STORIES_PER_RUN=3
MAX_SOURCE_AGE_HOURS=48
MIN_VIRAL_SCORE=60
DAY_TIMEZONE=Africa/Casablanca

# --- Network ---
REQUEST_TIMEOUT=60
IMAGE_REQUEST_TIMEOUT=180
MAX_RETRIES=3
PER_HOST_DELAY_SECONDS=2.0
USER_AGENT=ViralStoriesFactoryBot/1.0

# --- Files ---
HISTORY_FILE=data/history.json
SOURCES_OVERRIDE_FILE=

# --- Behaviour ---
DRY_RUN=true
DRY_RUN_GENERATE_IMAGES=false
GIT_PUSH_ENABLED=false

# يتجاوز الحد اليومي.
# يفضل استخدامه للتشغيل اليدوي فقط.
MANUAL_OVERRIDE=false

# فحص الصورة المولدة باستخدام Gemini Vision/structured output
IMAGE_VLM_CHECK=true

# إذا true، لا يُعتبر المقال منشورًا بدون صورة مولدة وصالحة.
# عند فشل الصورة تكون الحالة image_failed.
IMAGE_REQUIRED=true
